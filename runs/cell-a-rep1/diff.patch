+using System.Threading.Tasks;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Routing;
+using Microsoft.eShopWeb.ApplicationCore.Entities;
+using Microsoft.eShopWeb.ApplicationCore.Interfaces;
+using MinimalApi.Endpoint;
+
+namespace Microsoft.eShopWeb.PublicApi.CatalogItemEndpoints;
+
+/// <summary>
+/// Archives a Catalog Item so it is no longer visible to customers in the store
+/// </summary>
+public class ArchiveCatalogItemEndpoint : IEndpoint<IResult, ArchiveCatalogItemRequest, IRepository<CatalogItem>>
+{
+    public void AddRoute(IEndpointRouteBuilder app)
+    {
+        app.MapPut("api/catalog-items/{catalogItemId}/archive",
+            [Authorize(Roles = BlazorShared.Authorization.Constants.Roles.ADMINISTRATORS, AuthenticationSchemes = JwtBearerDefaults.AuthenticationScheme)] async
+            (int catalogItemId, IRepository<CatalogItem> itemRepository) =>
+            {
+                return await HandleAsync(new ArchiveCatalogItemRequest(catalogItemId), itemRepository);
+            })
+            .Produces<ArchiveCatalogItemResponse>()
+            .WithTags("CatalogItemEndpoints");
+    }
+
+    public async Task<IResult> HandleAsync(ArchiveCatalogItemRequest request, IRepository<CatalogItem> itemRepository)
+    {
+        var response = new ArchiveCatalogItemResponse(request.CorrelationId());
+
+        var itemToArchive = await itemRepository.GetByIdAsync(request.CatalogItemId);
+        if (itemToArchive is null)
+            return Results.NotFound();
+
+        itemToArchive.Archive();
+        await itemRepository.UpdateAsync(itemToArchive);
+
+        response.CatalogItem = new CatalogItemDto
+        {
+            Id = itemToArchive.Id,
+            CatalogBrandId = itemToArchive.CatalogBrandId,
+            CatalogTypeId = itemToArchive.CatalogTypeId,
+            Description = itemToArchive.Description,
+            Name = itemToArchive.Name,
+            PictureUri = itemToArchive.PictureUri,
+            Price = itemToArchive.Price,
+            IsArchived = itemToArchive.IsArchived
+        };
+
+        return Results.Ok(response);
+    }
+}
