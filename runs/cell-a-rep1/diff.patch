+using Microsoft.eShopWeb;
+using Microsoft.eShopWeb.PublicApi.CatalogItemEndpoints;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Threading.Tasks;
+
+namespace PublicApiIntegrationTests.CatalogItemEndpoints;
+
+[TestClass]
+public class ArchiveCatalogItemEndpointTest
+{
+    [TestMethod]
+    public async Task ReturnsNotAuthorizedGivenNormalUserToken()
+    {
+        var token = ApiTokenHelper.GetNormalUserToken();
+        var client = ProgramTest.NewClient;
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
+        var response = await client.PutAsync("api/catalog-items/1/archive", null);
+
+        Assert.AreEqual(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ReturnsSuccessGivenValidIdAndAdminUserToken()
+    {
+        var adminToken = ApiTokenHelper.GetAdminUserToken();
+        var client = ProgramTest.NewClient;
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", adminToken);
+        var response = await client.PutAsync("api/catalog-items/1/archive", null);
+        response.EnsureSuccessStatusCode();
+        var stringResponse = await response.Content.ReadAsStringAsync();
+        var model = stringResponse.FromJson<ArchiveCatalogItemResponse>();
+
+        Assert.IsTrue(model!.CatalogItem.IsArchived);
+
+        // restore state for other tests relying on this seeded item
+        await client.PutAsync("api/catalog-items/1/unarchive", null);
+    }
+
+    [TestMethod]
+    public async Task ReturnsNotFoundGivenInvalidIdAndAdminUserToken()
+    {
+        var adminToken = ApiTokenHelper.GetAdminUserToken();
+        var client = ProgramTest.NewClient;
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", adminToken);
+        var response = await client.PutAsync("api/catalog-items/0/archive", null);
+
+        Assert.AreEqual(HttpStatusCode.NotFound, response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ArchivedItemIsExcludedFromDefaultListButIncludedWhenRequested()
+    {
+        var adminToken = ApiTokenHelper.GetAdminUserToken();
+        var client = ProgramTest.NewClient;
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", adminToken);
+
+        var archiveResponse = await client.PutAsync("api/catalog-items/2/archive", null);
+        archiveResponse.EnsureSuccessStatusCode();
+
+        var defaultListResponse = await client.GetAsync("api/catalog-items?pageSize=100");
+        var defaultList = (await defaultListResponse.Content.ReadAsStringAsync()).FromJson<ListPagedCatalogItemResponse>();
+        Assert.IsFalse(defaultList!.CatalogItems.Exists(i => i.Id == 2));
+
+        var includeArchivedResponse = await client.GetAsync("api/catalog-items?pageSize=100&includeArchived=true");
+        var includeArchivedList = (await includeArchivedResponse.Content.ReadAsStringAsync()).FromJson<ListPagedCatalogItemResponse>();
+        Assert.IsTrue(includeArchivedList!.CatalogItems.Exists(i => i.Id == 2 && i.IsArchived));
+
+        // restore state for other tests relying on this seeded item
+        await client.PutAsync("api/catalog-items/2/unarchive", null);
+    }
+}
